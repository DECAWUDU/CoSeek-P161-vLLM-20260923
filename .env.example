# All three strong-model roles use this one internal service.
OPENAI_API_BASE='http://10.90.79.125:8077/v1'
# EMPTY is only for a server without authentication. Otherwise set your real key.
OPENAI_API_KEY='EMPTY'
# AUTO queries /v1/models and requires exactly one served model.
OPENAI_MODEL='AUTO'
# Keep server's thinking default; true/false explicitly changes that behavior.
VLLM_ENABLE_THINKING='server'
VLLM_JSON_MODE='true'
VLLM_PROBE_IMAGES='32'
# Explicitly select a GPU with space for the small search model.
# Do not automatically select one of the four GPUs occupied by the 397B service.
COSEEK_GPU=''
QWEN_MODEL_PATH='models/Qwen3.5-9B'
QWEN_PYTHON='.venvs/qwen/bin/python'
COSEEK_MAIN_PYTHON='.venvs/main/bin/python'
